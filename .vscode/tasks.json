{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quarkus: iniciar em desenvolvimento",
      "type": "shell",
      "command": "JAVA_HOME=\"/usr/lib/jvm/java-21-openjdk-amd64\" \"${workspaceFolder}/.tools/apache-maven-3.9.16/bin/mvn\" quarkus:dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Qualidade: testes e cobertura",
      "type": "shell",
      "command": "JAVA_HOME=\"/usr/lib/jvm/java-21-openjdk-amd64\" \"${workspaceFolder}/.tools/apache-maven-3.9.16/bin/mvn\" verify",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$javac"
    },
    {
      "label": "Docker: subir API e banco",
      "type": "shell",
      "command": "docker compose up --build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: parar ambiente",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    }
  ]
}
